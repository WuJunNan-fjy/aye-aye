{
  "name": "aye-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "aye-aye desktop app - AI-driven Linux server operations over SSH",
  "author": "WuJunNan-fjy",
  "license": "MIT",
  "homepage": "https://github.com/WuJunNan-fjy/aye-aye#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WuJunNan-fjy/aye-aye.git"
  },
  "bugs": {
    "url": "https://github.com/WuJunNan-fjy/aye-aye/issues"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev -- --remote-debugging-port=9223",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "prepare:backend": "node scripts/prepare-backend.cjs",
    "dist": "node scripts/prepare-backend.cjs && electron-vite build && electron-builder --publish never",
    "dist:dir": "node scripts/prepare-backend.cjs && electron-vite build && electron-builder --dir --publish never",
    "build:icon": "node scripts/build-icon.js"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "electron": "^44.7.2",
    "electron-builder": "^25.0.0",
    "electron-vite": "^3.0.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "typescript": "^5.5.0",
    "vite": "^5.3.0"
  }
}
